# ============================================
# Micro-Contract Finder — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# --------------------------------------------
# SAM.gov API
# --------------------------------------------
# Get your key: https://sam.gov → Profile → Account Details → "Request Public API Key"
# Approval takes ~10-30 minutes. Free tier: 1,000 requests/day.
SAM_GOV_API_KEY=your_sam_gov_key_here

# --------------------------------------------
# Resend (email alerts)
# --------------------------------------------
# Sign up free: https://resend.com — 100 emails/day free tier, no credit card.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_key_here

# The email address alerts will be sent FROM.
# For testing: use "onboarding@resend.dev" (Resend's test sender)
# For production: verify your own domain in Resend and use e.g. "alerts@yourdomain.com"
ALERT_FROM_EMAIL=onboarding@resend.dev

# The email address that RECEIVES alerts (your address)
ALERT_TO_EMAIL=you@example.com

# Minimum opportunity score (0-100) to trigger an email alert
ALERT_MIN_SCORE=70

# --------------------------------------------
# Database
# --------------------------------------------
# SQLite file (default, zero-config, great for single-user local use)
DATABASE_URL="file:./dev.db"

# For production on Vercel/Railway, switch to Postgres:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# --------------------------------------------
# Cron security
# --------------------------------------------
# A random secret to protect your /api/cron endpoint from being hit by randos.
# Generate one: run `openssl rand -hex 32` in your terminal
CRON_SECRET=change_me_to_a_random_string

# --------------------------------------------
# Filter defaults (optional — can be overridden in UI)
# --------------------------------------------
DEFAULT_MAX_VALUE=15000
DEFAULT_DEADLINE_DAYS=7
DEFAULT_NAICS_CODES=541511,541512,541430,541810
DEFAULT_KEYWORDS=web design,website,web development,UX,WordPress,landing page
